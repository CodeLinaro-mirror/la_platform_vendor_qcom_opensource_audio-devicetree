/dts-v1/;
/plugin/;

#include "pebble-audio-mtp-wcd9378.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. Pebble MTP + wcn7750 + Estoril";
	compatible = "qcom,pebble-mtp", "qcom,pebblep-mtp", "qcom,mtp", "qcom,pebble", "qcom,pebblep";
	qcom,msm-id = <735 0x10000>, <741 0x10000>;
	qcom,board-id = <0x10008 0x0>, <0x10108 0x0>;
};

