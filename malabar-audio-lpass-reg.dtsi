&rx_macro:rx_macro@A600000  {
	reg = <0xA600000 0x0>;
};

&rx_swr {
	swrm-io-base = <0xA610000 0x0>;
	interrupts = <GIC_SPI 297 IRQ_TYPE_LEVEL_HIGH>;
};

&tx_macro:tx_macro@A620000  {
	reg = <0xA620000 0x0>;
};

&va_macro:va_macro@A730000  {
	reg = <0xA730000 0x0>;
};

&tx_swr {
	swrm-io-base = <0xA740000 0x0>;
	interrupts = <GIC_SPI 296 IRQ_TYPE_LEVEL_HIGH>;
};

&tlmm:tlmm@A7C0000  {
	reg = <0xA7C0000 0x0>;
};

