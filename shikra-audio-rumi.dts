/dts-v1/;
/plugin/;

#include "shikra-audio-rumi.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. Shikra RUMI";
	compatible = "qcom,shikra-rumi", "qcom,shikra", "qcom,rumi";
	qcom,msm-id = <707 0x10000>, <707 0x20000>, <708 0x10000>, <708 0x20000>;
	qcom,board-id = <15 0>;
};
